# --- Cluster ----------------------------------------------------------------
# API server URL. From the console: username menu → Copy login command → the value after --server=.
OPENSHIFT_SERVER=https://api.cluster.example.com:6443

# --- Authentication ---------------------------------------------------------
# Auth is chosen automatically: token if OPENSHIFT_TOKEN is set, else username/password.
# Override explicitly with OPENSHIFT_AUTH=token|password.

# A) Bearer token — console: username menu → Copy login command → Display Token → after --token=.
#    (or `oc whoami -t`). Console tokens are short-lived.
OPENSHIFT_TOKEN=

# B) Username / password for the cluster's local identity provider (HTPasswd/LDAP). Sent only to the
#    cluster's OAuth server; token is cached and auto-refreshed. Leave OPENSHIFT_TOKEN blank to use.
OPENSHIFT_USERNAME=
OPENSHIFT_PASSWORD=
# OAuth client for the challenge flow (rarely changed).
OPENSHIFT_OAUTH_CLIENT=openshift-challenging-client
# Where the cached token is stored. Default: ~/.mcp-openshift/token.json
OPENSHIFT_TOKEN_CACHE=

# --- TLS --------------------------------------------------------------------
# Path to the cluster CA bundle (PEM) so certs verify.
OPENSHIFT_CA_CERT=
# Skip TLS verification — DEVELOPMENT ONLY (disables MITM protection).
OPENSHIFT_INSECURE_TLS=false

# --- Connection -------------------------------------------------------------
OPENSHIFT_TIMEOUT_MS=30000
# Max items returned per list (1-500).
OPENSHIFT_MAX_RESULTS=100

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  -> whoami, list_projects, list_resources, get_resource, pod_logs, list_events
#   read-write -> adds scale, rollout_restart, apply_resource
#   admin      -> adds delete_resource (needs OPENSHIFT_ALLOW_DELETE=true)
OPENSHIFT_MODE=read-only
# Comma-separated namespaces writes/deletes are confined to. Empty = all (RBAC still applies).
OPENSHIFT_NAMESPACE_ALLOWLIST=
# Comma-separated namespaces readable but never mutated (supports a trailing *). Empty = built-in defaults
# (kube-system, kube-public, kube-node-lease, default, openshift, openshift-*, ...).
OPENSHIFT_PROTECTED_NAMESPACES=
# Creating/updating resources (apply_resource) requires this in addition to read-write mode.
OPENSHIFT_ALLOW_APPLY=false
# Destructive ops (delete_resource) require this in addition to admin mode.
OPENSHIFT_ALLOW_DELETE=false
# Validate + admission-check writes without persisting (Kubernetes dryRun=All).
OPENSHIFT_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
OPENSHIFT_AUDIT_LOG=true
